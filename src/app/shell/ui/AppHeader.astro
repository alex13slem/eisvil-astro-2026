---
import logoPng from "@/shared/assets/logo.png";
import { Image } from "astro:assets";
import { navLinks } from "../lib/nav-links";
import MobileMenu from "./MobileMenu.svelte";
---

<header class="container">
  <div class="_logo">
    <Image src={logoPng} alt="logo" height={46} />
  </div>
  <nav>
    {navLinks.map((link) => <a href={link.href}>{link.name}</a>)}
  </nav>
  <div class="mobile-menu">
    <MobileMenu client:only="svelte" />
  </div>
</header>

<style>
  header {
    padding-block: 1.5rem;
    display: flex;
    align-items: center;
    gap: 4rem;

    ._logo {
      height: 46px;

      @media (width < 1024px) {
        height: 35px;
      }

      img {
        height: 100%;
        width: auto;
      }
    }
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;

    @media (width < 1024px) {
      display: none;
    }

    a {
      font-weight: 700;
      font-variant-caps: all-small-caps;
    }
  }

  .mobile-menu {
    margin-left: auto;
    @media (width >= 1024px) {
      display: none;
    }
  }
</style>
