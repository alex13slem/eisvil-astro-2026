---
import { AppLayout, AppMain } from "@/app/shell";
import decor from "@/shared/assets/404.png";
import { Image } from "astro:assets";
---

<AppLayout title="Страница не найдена" description="Страница не найдена">
  <AppMain class="container">
    <Image class="decor" src={decor} alt="" />
    <p>Кажется, такой страницы не существует.</p>
    <a href="/">На главную</a>
  </AppMain>
</AppLayout>

<style>
  main {
    min-height: 60vh;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  a {
    font-weight: 600;
  }

  .decor {
    object-fit: contain;
  }
</style>
