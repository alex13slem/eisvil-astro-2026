---
import { AppLayout, AppMain } from "@/app/shell";
import { type Game } from "@/entities/games";
import { fetchGames } from "@/entities/games/server";
import { GameDetailSection } from "@/widgets/game-detail-section/server";
import {
  fetchGameFeaturesSectionData,
  GameFeaturesSection,
  type GameFeaturesSectionData,
} from "@/widgets/game-features-section/server";
import type { GameTeamMember } from "@/widgets/game-team-section";
import {
  fetchGameTeamMembers,
  GameTeamSection,
} from "@/widgets/game-team-section/server";
import { GameplayGallerySection } from "@/widgets/gameplay-gallery-section/server";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const games = await fetchGames();

  const featureSectionDataMap = new Map<string, GameFeaturesSectionData>();
  for (const game of games) {
    const featureSectionData = await fetchGameFeaturesSectionData(game.id);
    featureSectionDataMap.set(game.id, featureSectionData);
  }

  const teamTeamMembersMap = new Map<string, GameTeamMember[]>();
  for (const game of games) {
    const teamMembers = await fetchGameTeamMembers(game.id);
    teamTeamMembersMap.set(game.id, teamMembers);
  }

  return games.map((game) => {
    return {
      params: { slug: game.slug },
      props: {
        game,
        featureSectionData: featureSectionDataMap.get(game.id)!,
        teamMembers: teamTeamMembersMap.get(game.id)!,
      },
    };
  });
};

interface Props {
  game: Game;
  featureSectionData: GameFeaturesSectionData;
  teamMembers: GameTeamMember[];
}

const { game, featureSectionData, teamMembers } = Astro.props;
---

<AppLayout title={game.name}>
  <AppMain>
    <GameDetailSection {game} />
    <GameplayGallerySection class="gameplay-gallery" gameId={game.id} />
    {
      !!featureSectionData.features.length && (
        <GameFeaturesSection class="section" {...featureSectionData} />
      )
    }
    {
      !!teamMembers.length && (
        <GameTeamSection class="section" members={teamMembers} />
      )
    }
  </AppMain>
</AppLayout>

<style>
  .gameplay-gallery {
    margin-top: 2rem;

    @media (width < 1440px) {
      margin-top: 1.5rem;
    }
    @media (width < 768px) {
      margin-top: 0.5rem;
    }
  }

  .section {
    margin-top: 96px;
  }
</style>
