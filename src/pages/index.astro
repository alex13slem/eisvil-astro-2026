---
import { AppLayout, AppMain } from "@/app/shell";
import { CareerLandingSection } from "@/widgets/career-landing-section/server";
import { GamesGalleryLandingSection } from "@/widgets/games-gallery-section/server";
import { SelectServiceSection } from "@/widgets/select-service-section/server";
import { Top3GamesLandingSection } from "@/widgets/top-3-games-landing-section/server";
---

<AppLayout title="Games">
  <AppMain>
    <Top3GamesLandingSection />
    <GamesGalleryLandingSection />
    <SelectServiceSection />
    <CareerLandingSection />
  </AppMain>
</AppLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 8rem;

    @media (width < 1024px) {
      gap: 6rem;
    }

    @media (width < 768px) {
      gap: 4rem;
    }
  }
</style>
