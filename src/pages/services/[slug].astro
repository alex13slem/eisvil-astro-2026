---
import { AppLayout, AppMain } from "@/app/shell";
import type { Service } from "@/entities/services";
import { fetchServices } from "@/entities/services/server";
import { MDSection } from "@/shared/ui";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const [publishingService, developmentService] = await fetchServices();

  return ["publishing", "development"].map((slug) => ({
    params: { slug },
    props: {
      service: slug === "publishing" ? publishingService : developmentService,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Missing game slug");
}
const title = slug === "publishing" ? "Публикация игр" : "Разработка игр";
const { service } = Astro.props;
---

<AppLayout {title}>
  <AppMain>
    <MDSection md={service.body} img={{ src: service.image, alt: title }} />
  </AppMain>
</AppLayout>
