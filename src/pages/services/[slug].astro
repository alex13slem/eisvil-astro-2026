---
import { AppLayout, AppMain } from "@/app/shell";
import {
  SERVICES_SLUGS,
  type Service,
  type ServicesSlug,
} from "@/entities/services";
import { fetchServices } from "@/entities/services/server";
import { DevelopmentOrderCTATrigger } from "@/features/development-order-cta";
import { PublishingCTATrigger } from "@/features/publishing-cta";
import { MDSection } from "@/shared/ui";
import type { GetStaticPaths } from "astro";

interface Props {
  service: Service;
}

export const getStaticPaths = (async () => {
  const [publishingService, developmentService] = await fetchServices();
  return SERVICES_SLUGS.map((slug) => ({
    params: { slug },
    props: {
      service: slug === "publishing" ? publishingService : developmentService,
    },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params as { slug: ServicesSlug };

const title = slug === "publishing" ? "Публикация игр" : "Разработка игр";
const { service } = Astro.props;
---

<AppLayout {title}>
  <AppMain>
    <MDSection md={service.body} img={{ src: service.image, alt: title }} />
    <section id="cta-section" class="container">
      <div class="prose">
        {slug === "development" && <DevelopmentOrderCTATrigger client:load />}
        {slug === "publishing" && <PublishingCTATrigger client:load />}
      </div>
    </section>
  </AppMain>
</AppLayout>

<style>
  #cta-section {
    position: relative;
    z-index: 2;
    margin-top: 4rem;
    .prose {
      margin-inline: auto;
      display: flex;
      justify-content: center;
    }
  }
</style>
